# DeepSeek 中转 profile —— 推荐用 `cca init deepseek` 生成(自动 chmod 600,CC_KEY=xxx 可注入)。
# 各键含义见 README《第三方中转》。
#
# DeepSeek 提供官方 Anthropic 兼容端点,Claude Code 直接可跑 DeepSeek 模型。
# 详见 https://api-docs.deepseek.com/zh-cn/quick_start/agent_integrations/claude_code

# DeepSeek 官方 Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=在此填你的DeepSeekAPIKEY

# 模型映射:Claude 大/中/小三档 → DeepSeek 模型
# deepseek-v4-pro[1m] 是 1M 上下文版本,适合长任务;flash 走轻量/快
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# Subagent 走更便宜的 flash(主对话保持 pro)
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash

# 触发自动压缩的上下文窗口大小(配合上面 [1m] 大窗口模型;不确定就别动)
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# 可选代理(DeepSeek 国内直连,通常不需要;宿主机代理写 host.docker.internal,不能写 127.0.0.1)
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897