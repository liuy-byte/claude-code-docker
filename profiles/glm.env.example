# 智谱 GLM 中转 profile —— 推荐用 `cca init glm` 生成(自动 chmod 600,CC_KEY=xxx 可注入)。
# 各键含义见 README《第三方中转》。

# 智谱官方 Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=在此填你的智谱APIKEY

# 模型映射:Claude 大/中/小三档 → GLM 模型
# glm-5.2[1m] 是 1M 上下文版本,适合长任务;glm-4.7 走轻量/快
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7

# 主对话启动时的默认活动模型(与 opus 档一致 = glm-5.2[1m];可选,不设则走 Default = opus 档)。
# 会被会话内 /model、--model 覆盖。
ANTHROPIC_MODEL=glm-5.2[1m]

# 推理深度(自适应推理)拉满;env 变量优先于 /effort 与 settings 的 effortLevel,不会被覆盖
CLAUDE_CODE_EFFORT_LEVEL=max

# 自定义模型 ID(glm-*)不被 Claude Code 识别为支持 effort —— 必须声明能力,
# 上面 EFFORT_LEVEL=max 才会真正作为 effort 参数发给网关;不支持的档位会自动降到模型最高档。
# (若中转网关拒绝 thinking 参数,再用 CLAUDE_CODE_DISABLE_THINKING=1 单独关 thinking 维度)
ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES='effort,xhigh_effort,max_effort,thinking,adaptive_thinking'
ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES='effort,xhigh_effort,max_effort,thinking,adaptive_thinking'
ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES='effort,xhigh_effort,max_effort,thinking,adaptive_thinking'

# 触发自动压缩的上下文窗口大小(配合上面 [1m] 大窗口模型;不确定就别动)
CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000

# 可选代理(智谱国内直连,通常不需要;宿主机代理写 host.docker.internal,不能写 127.0.0.1)
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
